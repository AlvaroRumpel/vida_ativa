# Supabase Cloud Staging Credentials
# Copy this file to .env and fill with real values from Supabase dashboard
# NEVER commit .env — it is gitignored

# From: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# DATABASE URL (from Supabase Dashboard > Project Settings > Database > Connection string)
# Use "URI" format, mode "Session"
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# SECRET KEY — NEVER put in Flutter app; NEVER commit this file
# From: Supabase Dashboard > Project Settings > API > Secret key
SUPABASE_SECRET_KEY=sb_secret_your_key_here
