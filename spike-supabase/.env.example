# Supabase Cloud Staging Credentials
# Copy this file to .env and fill with real values from Supabase dashboard
# NEVER commit .env — it is gitignored

# From: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder

# DATABASE URL (for psql CLI testing — from Supabase Dashboard > Project Settings > Database > Connection string)
# Use "URI" format, mode "Session"
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# SERVICE ROLE KEY — NEVER put this in Flutter app; NEVER commit this file
# Used only for psql admin operations during Phase 31 testing
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here
# (comment stays commented — uncomment in local .env only if needed)
