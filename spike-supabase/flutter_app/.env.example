# SPIKE-08 Flutter mini-app environment variables
# Copy to .env and fill in real values (never commit .env)
# Usage: flutter run -d chrome \
#   --dart-define=SUPABASE_URL=https://fasirsbiadcchfgvktzt.supabase.co \
#   --dart-define=SUPABASE_ANON_KEY=<anon_key_from_supabase_dashboard> \
#   --dart-define=TEST_EMAIL_1=testclient@spike.local \
#   --dart-define=TEST_PASSWORD_1=<password> \
#   --dart-define=TEST_EMAIL_2=testadmin@spike.local \
#   --dart-define=TEST_PASSWORD_2=<password>

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...your_anon_key_here
TEST_EMAIL_1=testclient@spike.local
TEST_PASSWORD_1=REPLACE_WITH_PASSWORD
